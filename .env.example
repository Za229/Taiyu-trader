# Public data exchange (CCXT exchange id)
EXCHANGE_ID=binance
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=5m
CANDLE_LIMIT=100

# Safety-first default. Do not change until sandbox testing and code review.
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false
LIVE_TRADING_ACK=
API_KEY=
API_SECRET=
API_PASSWORD=

# Risk limits for future execution adapter
MAX_POSITION_USDT=25
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_USDT=10
