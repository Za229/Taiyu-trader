# CoinDCX public market data
EXCHANGE_ID=coindcx
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=1m
CANDLE_LIMIT=100

# Safety-first default. Real order placement is not implemented.
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false
LIVE_TRADING_ACK=
API_KEY=
API_SECRET=
API_PASSWORD=

# Risk limits reserved for future implementation
MAX_POSITION_INR=2000
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_INR=500
